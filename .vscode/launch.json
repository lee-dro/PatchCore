{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "PatchCore Demo - Streamlit",
            "type": "debugpy",
            "request": "launch",
            "python": "D:/miniconda3/envs/patchcore/python.exe",
            "module": "streamlit",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "STREAMLIT_BROWSER_GATHER_USAGE_STATS": "false"
            },
            "args": [
                "run",
                "${workspaceFolder}/demo/app.py",
                "--server.headless=true",
                "--server.port=8502",
                "--server.runOnSave=true",
                "--browser.gatherUsageStats=false"
            ]
        }
    ]
}
