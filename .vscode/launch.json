{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "PatchCore - sensitivity shrinkage with optional gate",
            "type": "debugpy",
            "request": "launch",
            "python": "D:/miniconda3/envs/patchcore/python.exe",
            "program": "${workspaceFolder}/bin/run_patchcore.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {"PYTHONPATH": "${workspaceFolder}/src"},
            "args": [
                "--gpu", "0",
                "--seed", "0",
                "--log_group", "adaptive_bottle_s0",
                "--task_decoupled_ablation",
                "--pixel_sensitivity_shrinkage", "0.25",
                "--sensitivity_gate",
                "--gate_mode", "legacy",
                "--gate_min_group_consistency", "0.8",
                "--gate_max_layer2_weight", "0.8",
                "--gate_min_layer3_stability", "0.9",
                "--adaptive_max_samples", "64",
                "results", "patch_core",
                "-b", "wideresnet50", "-b", "wideresnet50",
                "-le", "0.layer2", "-le", "1.layer3",
                "--image_fusion_weight", "0.9", "--image_fusion_weight", "0.1",
                "--pixel_fusion_weight", "0.5", "--pixel_fusion_weight", "0.5",
                "--pretrain_embed_dimension", "1024",
                "--target_embed_dimension", "1024",
                "--anomaly_scorer_num_nn", "1",
                "--patchsize", "3",
                "sampler",
                "-p", "0.01",
                "approx_greedy_coreset",
                "dataset",
                "--train_val_split", "0.8",
                "--num_workers", "0",
                "--resize", "256",
                "--imagesize", "224",
                "-d", "bottle",
                "mvtec",
                "E:\\Datasets\\MVTecAD\\mvtec"
            ]
        }
    ]
}
